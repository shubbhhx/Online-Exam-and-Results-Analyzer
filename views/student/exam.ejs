<%- include('../partials/header', { title: title }) %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3><%= exam.subject_name %> Exam</h3>
      <p class="text-muted">Duration: <%= exam.duration_minutes %> minutes</p>
    </div>
    <div class="card card-stat p-3">
      <div class="fw-bold">Time Left</div>
      <div id="timer" data-minutes="<%= exam.duration_minutes %>">00:00</div>
    </div>
  </div>
  <div id="questionCounter" class="mb-3"></div>
  <form id="examForm" method="POST" action="/student/exams/<%= exam.id %>/submit" data-show-loader="true">
    <% mcqs.forEach((question, idx) => { %>
      <div class="exam-question <%= idx === 0 ? 'active' : '' %>">
        <div class="card card-elevated p-4">
          <h5>MCQ <%= idx + 1 %></h5>
          <p><%= question.question_text %></p>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="mcq_<%= question.id %>" value="A" />
            <label class="form-check-label"><%= question.option_a %></label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="mcq_<%= question.id %>" value="B" />
            <label class="form-check-label"><%= question.option_b %></label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="mcq_<%= question.id %>" value="C" />
            <label class="form-check-label"><%= question.option_c %></label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="mcq_<%= question.id %>" value="D" />
            <label class="form-check-label"><%= question.option_d %></label>
          </div>
        </div>
      </div>
    <% }) %>
    <% descs.forEach((question, idx) => { %>
      <div class="exam-question">
        <div class="card card-elevated p-4">
          <h5>Descriptive <%= idx + 1 %></h5>
          <p><%= question.question_text %></p>
          <textarea class="form-control" name="desc_<%= question.id %>" rows="5" placeholder="Write your answer"></textarea>
        </div>
      </div>
    <% }) %>
    <div class="d-flex justify-content-between mt-4">
      <button class="btn btn-outline-dark" type="button" id="prevBtn">Previous</button>
      <button class="btn btn-outline-dark" type="button" id="nextBtn">Next</button>
      <button class="btn btn-brand" type="submit" onclick="return confirm('Submit exam now?')">Final Submit</button>
    </div>
  </form>
</div>
<script src="/public/js/exam.js"></script>
<%- include('../partials/footer') %>
