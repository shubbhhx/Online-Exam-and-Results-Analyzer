<%- include('../partials/header', { title: title, toast: toast }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/student_sidebar') %>
    <div class="col-md-9 p-4">
      <h2>Exam History</h2>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Subject</th>
              <th>Total Marks</th>
              <th>Percentage</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach((result) => { %>
              <tr>
                <td><%= result.subject_name %></td>
                <td><%= result.total_marks %></td>
                <td><%= result.percentage %>%</td>
                <td><span class="badge-soft"><%= result.status %></span></td>
                <td><a class="btn btn-sm btn-outline-dark" href="/student/results/<%= result.id %>">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
