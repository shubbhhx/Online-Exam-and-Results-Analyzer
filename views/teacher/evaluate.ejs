<%- include('../partials/header', { title: title }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/teacher_sidebar') %>
    <div class="col-md-9 p-4">
      <h2>Evaluate Descriptive Answers</h2>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Student</th>
              <th>Subject</th>
              <th>Answer</th>
              <th>Marks</th>
            </tr>
          </thead>
          <tbody>
            <% answers.forEach((item) => { %>
              <tr>
                <td><%= item.student_name %></td>
                <td><%= item.subject_name %></td>
                <td>
                  <div class="card card-elevated p-3">
                    <%= item.answer_text %>
                  </div>
                </td>
                <td>
                  <form method="POST" action="/teacher/evaluate/<%= item.id %>" data-show-loader="true">
                    <div class="input-group">
                      <input class="form-control" name="marks_awarded" type="number" min="0" max="5" required />
                      <button class="btn btn-brand" type="submit">Save</button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
