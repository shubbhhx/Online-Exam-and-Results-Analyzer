<%- include('../partials/header', { title: title }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/teacher_sidebar') %>
    <div class="col-md-9 p-4">
      <h2>Question Bank</h2>
      <% if (error) { %>
        <div class="alert alert-warning"><%= error %></div>
      <% } %>
      <form class="row g-3" method="POST" action="/teacher/questions">
        <div class="col-md-4">
          <select class="form-select" name="subject_id" required>
            <option value="">Select Subject</option>
            <% subjects.forEach((subject) => { %>
              <option value="<%= subject.id %>"><%= subject.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select" name="question_type" required>
            <option value="MCQ">MCQ</option>
            <option value="DESCRIPTIVE">Descriptive</option>
          </select>
        </div>
        <div class="col-md-5">
          <input class="form-control" name="question_text" placeholder="Question" required />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="option_a" placeholder="Option A" />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="option_b" placeholder="Option B" />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="option_c" placeholder="Option C" />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="option_d" placeholder="Option D" />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="correct_option" placeholder="Correct Option (A-D)" />
        </div>
        <div class="col-md-2">
          <button class="btn btn-brand w-100" type="submit">Add</button>
        </div>
      </form>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Subject</th>
              <th>Type</th>
              <th>Question</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% questions.forEach((question) => { %>
              <tr>
                <td><%= question.subject_name %></td>
                <td><%= question.question_type %></td>
                <td><%= question.question_text %></td>
                <td class="d-flex gap-2">
                  <a class="btn btn-sm btn-outline-dark" href="/teacher/questions/<%= question.id %>/edit">Edit</a>
                  <form method="POST" action="/teacher/questions/<%= question.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
