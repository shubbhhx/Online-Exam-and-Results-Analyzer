<%- include('../partials/header', { title: title }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin_sidebar') %>
    <div class="col-md-9 p-4">
      <h2>Assign Teachers to Subjects</h2>
      <% if (error) { %>
        <div class="alert alert-warning"><%= error %></div>
      <% } %>
      <form class="row g-3" method="POST" action="/admin/assignments">
        <div class="col-md-5">
          <select class="form-select" name="teacher_id" required>
            <option value="">Select Teacher</option>
            <% teachers.forEach((teacher) => { %>
              <option value="<%= teacher.id %>"><%= teacher.name %> (<%= teacher.teacher_code %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-5">
          <select class="form-select" name="subject_id" required>
            <option value="">Select Subject</option>
            <% subjects.forEach((subject) => { %>
              <option value="<%= subject.id %>"><%= subject.name %> (Sem <%= subject.semester_number %>, <%= subject.course_name %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-brand w-100" type="submit">Assign</button>
        </div>
      </form>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Teacher</th>
              <th>Subject</th>
              <th>Course</th>
              <th>Semester</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% assignments.forEach((item) => { %>
              <tr>
                <td><%= item.teacher_name %> (<%= item.teacher_code %>)</td>
                <td><%= item.subject_name %></td>
                <td><%= item.course_name %></td>
                <td>Semester <%= item.semester_number %></td>
                <td>
                  <form method="POST" action="/admin/assignments/<%= item.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
