<%- include('../partials/header', { title: title }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin_sidebar') %>
    <div class="col-md-9 p-4 section-hero">
      <h2>Subjects</h2>
      <p class="text-muted">Subjects are created while defining a semester.</p>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Name</th>
              <th>Course</th>
              <th>Semester</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach((subject) => { %>
              <tr>
                <td><%= subject.name %></td>
                <td><%= subject.course_name %></td>
                <td>Semester <%= subject.semester_number %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
