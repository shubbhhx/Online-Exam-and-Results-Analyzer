<%- include('../partials/header', { title: title, pageLoading: true }) %>
<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin_sidebar') %>
    <div class="col-md-9 p-4 section-hero">
      <h2>Manage Semesters</h2>
      <p class="text-muted">Add all subjects while creating a semester.</p>
      <form class="row g-3" method="POST" action="/admin/semesters" data-show-loader="true">
        <div class="col-md-4">
          <select class="form-select" name="course_id" required>
            <option value="">Select course</option>
            <% courses.forEach((course) => { %>
              <option value="<%= course.id %>"><%= course.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <input class="form-control" name="semester_number" type="number" min="1" max="10" placeholder="Semester No" required />
        </div>
        <div class="col-md-6">
          <input class="form-control" name="title" placeholder="Title (e.g., Semester 4)" required />
        </div>
        <div class="col-md-12">
          <textarea class="form-control" name="subjects" rows="3" placeholder="Subjects (comma or line separated)" required></textarea>
        </div>
        <div class="col-md-12">
          <button class="btn btn-brand w-100" type="submit">Create Semester</button>
        </div>
      </form>
      <div class="table-responsive mt-4">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Course</th>
              <th>Semester</th>
              <th>Subjects</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% semesters.forEach((semester) => { %>
              <tr>
                <td><%= semester.course_name %></td>
                <td>
                  <form method="POST" id="update-<%= semester.id %>" action="/admin/semesters/<%= semester.id %>/update" class="d-flex gap-2">
                    <input class="form-control" name="semester_number" value="<%= semester.semester_number %>" style="max-width: 120px" />
                    <input class="form-control" name="title" value="<%= semester.title %>" />
                    <button class="btn btn-sm btn-outline-dark" type="submit">Update</button>
                  </form>
                </td>
                <td>
                  <% subjects
                    .filter((subject) => subject.semester_id === semester.id)
                    .forEach((subject) => { %>
                      <span class="badge-soft me-1 mb-1"><%= subject.name %></span>
                  <% }) %>
                </td>
                <td>
                  <form method="POST" action="/admin/semesters/<%= semester.id %>/delete">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
